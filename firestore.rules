rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1 / Safety Net: Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global hardened helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isVerifiedOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isRecentServerTime(ts) {
      return ts is timestamp
        && duration.abs(request.time - ts) <= duration.value(10, 's');
    }

    function isValidAccount(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() <= 320
        && data.displayName is string
        && data.displayName.size() <= 120
        && data.photoURL is string
        && data.photoURL.size() <= 512
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCareerSave(data, userId) {
      return data.keys().hasAll([
          'uid',
          'driverName',
          'onboarded',
          'money',
          'fumaShards',
          'totalFumaShardsCollected',
          'totalCashEarned',
          'bestNoBrakeDriftSec',
          'bestContinuousPlaySec',
          'claimedQuests',
          'dailyLogin',
          'xp',
          'reputation',
          'rank',
          'activeCarId',
          'ownedCars',
          'completedEvents',
          'unlockedRegions',
          'achievements',
          'stats',
          'recentResults',
          'leaderboard',
          'settings',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'driverName',
          'driverAge',
          'onboarded',
          'money',
          'fumaShards',
          'totalFumaShardsCollected',
          'totalCashEarned',
          'bestNoBrakeDriftSec',
          'bestContinuousPlaySec',
          'claimedQuests',
          'dailyLogin',
          'xp',
          'reputation',
          'rank',
          'activeCarId',
          'ownedCars',
          'completedEvents',
          'unlockedRegions',
          'achievements',
          'stats',
          'recentResults',
          'leaderboard',
          'settings',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.driverName is string
        && data.driverName.size() >= 1
        && data.driverName.size() <= 18
        && (!('driverAge' in data) || data.driverAge == null || (data.driverAge is number && data.driverAge >= 6 && data.driverAge <= 120))
        && data.onboarded is bool
        && data.money is number && data.money >= 0
        && data.fumaShards is number && data.fumaShards >= 0
        && data.totalFumaShardsCollected is number && data.totalFumaShardsCollected >= 0
        && data.totalCashEarned is number && data.totalCashEarned >= 0
        && data.bestNoBrakeDriftSec is number && data.bestNoBrakeDriftSec >= 0
        && data.bestContinuousPlaySec is number && data.bestContinuousPlaySec >= 0
        && data.claimedQuests is list && data.claimedQuests.size() <= 20
        && (data.claimedQuests.size() == 0 || data.claimedQuests[0] is string)
        && data.dailyLogin is map
        && data.xp is number && data.xp >= 0
        && data.reputation is number && data.reputation >= 0
        && data.rank is string && data.rank in ['rookie', 'street', 'pro', 'elite', 'legend']
        && data.activeCarId is string && data.activeCarId.size() >= 1 && data.activeCarId.size() <= 64
        && data.ownedCars is map
        && data.ownedCars.size() >= 1 && data.ownedCars.size() <= 25
        && data.completedEvents is list && data.completedEvents.size() <= 100
        && (data.completedEvents.size() == 0 || data.completedEvents[0] is string)
        && data.unlockedRegions is list && data.unlockedRegions.size() <= 10
        && (data.unlockedRegions.size() == 0 || data.unlockedRegions[0] is string)
        && data.achievements is list && data.achievements.size() <= 64
        && (data.achievements.size() == 0 || data.achievements[0] is string)
        && data.stats is map
        && data.recentResults is list && data.recentResults.size() <= 20
        && (data.recentResults.size() == 0 || data.recentResults[0] is map)
        && data.leaderboard is list && data.leaderboard.size() <= 30
        && (data.leaderboard.size() == 0 || data.leaderboard[0] is map)
        && data.settings is map
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOnlineRoom(data, roomId) {
      return data.keys().hasAll([
          'roomId',
          'name',
          'hostUid',
          'hostDisplayName',
          'hostPhotoURL',
          'isPublic',
          'status',
          'regionId',
          'weather',
          'timeOfDay',
          'maxPlayers',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'roomId',
          'name',
          'hostUid',
          'hostDisplayName',
          'hostPhotoURL',
          'isPublic',
          'status',
          'regionId',
          'weather',
          'timeOfDay',
          'maxPlayers',
          'createdAt',
          'updatedAt'
        ])
        && data.roomId is string
        && data.roomId.size() >= 4
        && data.roomId.size() <= 24
        && isValidId(data.roomId)
        && data.roomId == roomId
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 40
        && data.hostUid is string
        && isValidId(data.hostUid)
        && data.hostDisplayName is string
        && data.hostDisplayName.size() >= 1
        && data.hostDisplayName.size() <= 80
        && data.hostPhotoURL is string
        && data.hostPhotoURL.size() <= 512
        && data.isPublic is bool
        && data.status is string
        && data.status in ['open', 'active', 'closed']
        && data.regionId is string
        && data.regionId in ['sunset_coast', 'palm_canyon', 'alpine_pass', 'fujimi_bay']
        && data.weather is string
        && data.weather in ['sunny', 'cloudy', 'rain', 'heavy_rain', 'thunderstorm', 'fog']
        && data.timeOfDay is string
        && data.timeOfDay in ['sunrise', 'day', 'sunset', 'night']
        && data.maxPlayers is number
        && data.maxPlayers >= 2
        && data.maxPlayers <= 12
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOnlinePlayer(data, roomId, playerId) {
      return data.keys().hasAll([
          'uid',
          'roomId',
          'googleDisplayName',
          'googlePhotoURL',
          'driverName',
          'rank',
          'carId',
          'paintColor',
          'paintFinish',
          'spoiler',
          'bodyKit',
          'x',
          'y',
          'z',
          'heading',
          'vx',
          'vz',
          'speedKmh',
          'steerAngle',
          'braking',
          'nitroActive',
          'headlightsOn',
          's',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'roomId',
          'googleDisplayName',
          'googlePhotoURL',
          'driverName',
          'rank',
          'carId',
          'paintColor',
          'paintFinish',
          'spoiler',
          'bodyKit',
          'x',
          'y',
          'z',
          'heading',
          'vx',
          'vz',
          'speedKmh',
          'steerAngle',
          'braking',
          'nitroActive',
          'headlightsOn',
          's',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == playerId
        && data.uid == request.auth.uid
        && data.roomId is string
        && data.roomId.size() >= 4
        && data.roomId.size() <= 24
        && isValidId(data.roomId)
        && data.roomId == roomId
        && data.googleDisplayName is string
        && data.googleDisplayName.size() >= 1
        && data.googleDisplayName.size() <= 80
        && data.googlePhotoURL is string
        && data.googlePhotoURL.size() <= 512
        && data.driverName is string
        && data.driverName.size() >= 1
        && data.driverName.size() <= 18
        && data.rank is string
        && data.rank in ['rookie', 'street', 'pro', 'elite', 'legend']
        && data.carId is string
        && data.carId.size() >= 1
        && data.carId.size() <= 64
        && data.paintColor is string
        && data.paintColor.size() >= 4
        && data.paintColor.size() <= 16
        && data.paintFinish is string
        && data.paintFinish in ['gloss', 'metallic', 'matte']
        && data.spoiler is string
        && data.spoiler in ['none', 'lip', 'gt_wing', 'swan_neck']
        && data.bodyKit is string
        && data.bodyKit in ['stock', 'street', 'widebody_gt']
        && data.x is number && data.x >= -5000 && data.x <= 5000
        && data.y is number && data.y >= -500 && data.y <= 2000
        && data.z is number && data.z >= -5000 && data.z <= 5000
        && data.heading is number && data.heading >= -100 && data.heading <= 100
        && data.vx is number && data.vx >= -300 && data.vx <= 300
        && data.vz is number && data.vz >= -300 && data.vz <= 300
        && data.speedKmh is number && data.speedKmh >= 0 && data.speedKmh <= 600
        && data.steerAngle is number && data.steerAngle >= -2 && data.steerAngle <= 2
        && data.braking is bool
        && data.nitroActive is bool
        && data.headlightsOn is bool
        && data.s is number && data.s >= 0 && data.s <= 1
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Isolated Private Google Account PII
    match /users/{userId}/private/{docId} {
      allow get: if isValidId(userId)
        && docId == 'account'
        && isVerifiedOwner(userId);

      allow list: if false;

      allow create: if isValidId(userId)
        && docId == 'account'
        && isVerifiedOwner(userId)
        && isValidAccount(incoming(), userId)
        && isRecentServerTime(incoming().createdAt)
        && isRecentServerTime(incoming().updatedAt);

      allow update: if isValidId(userId)
        && docId == 'account'
        && isVerifiedOwner(userId)
        && isValidAccount(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && isRecentServerTime(incoming().updatedAt)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'email',
          'displayName',
          'photoURL',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    // Player Cloud Career Save
    match /users/{userId}/saves/{saveId} {
      allow get: if isValidId(userId)
        && saveId == 'career'
        && isVerifiedOwner(userId);

      allow list: if false;

      allow create: if isValidId(userId)
        && saveId == 'career'
        && isVerifiedOwner(userId)
        && isValidCareerSave(incoming(), userId)
        && isRecentServerTime(incoming().createdAt)
        && isRecentServerTime(incoming().updatedAt);

      allow update: if isValidId(userId)
        && saveId == 'career'
        && isVerifiedOwner(userId)
        && isValidCareerSave(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && isRecentServerTime(incoming().updatedAt)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'driverName',
          'driverAge',
          'onboarded',
          'money',
          'fumaShards',
          'totalFumaShardsCollected',
          'totalCashEarned',
          'bestNoBrakeDriftSec',
          'bestContinuousPlaySec',
          'claimedQuests',
          'dailyLogin',
          'xp',
          'reputation',
          'rank',
          'activeCarId',
          'ownedCars',
          'completedEvents',
          'unlockedRegions',
          'achievements',
          'stats',
          'recentResults',
          'leaderboard',
          'settings',
          'updatedAt'
        ]);

      allow delete: if isValidId(userId)
        && saveId == 'career'
        && isVerifiedOwner(userId);
    }

    // Online Multiplayer Rooms (Verified Google Auth required)
    match /online_rooms/{roomId} {
      allow get: if isValidId(roomId)
        && roomId.size() >= 4
        && roomId.size() <= 24
        && isVerifiedUser();

      allow list: if isVerifiedUser()
        && resource.data.isPublic == true
        && resource.data.status in ['open', 'active'];

      allow create: if isValidId(roomId)
        && isVerifiedUser()
        && isValidOnlineRoom(incoming(), roomId)
        && incoming().hostUid == request.auth.uid
        && incoming().status == 'open'
        && isRecentServerTime(incoming().createdAt)
        && isRecentServerTime(incoming().updatedAt);

      allow update: if isValidId(roomId)
        && isVerifiedUser()
        && isValidOnlineRoom(incoming(), roomId)
        && existing().hostUid == request.auth.uid
        && existing().status != 'closed'
        && incoming().roomId == existing().roomId
        && incoming().hostUid == existing().hostUid
        && incoming().createdAt == existing().createdAt
        && isRecentServerTime(incoming().updatedAt)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'hostDisplayName',
          'hostPhotoURL',
          'isPublic',
          'status',
          'regionId',
          'weather',
          'timeOfDay',
          'updatedAt'
        ]);

      allow delete: if isValidId(roomId)
        && isVerifiedUser()
        && existing().hostUid == request.auth.uid;

      // Live Player Vehicle State & Public Google Identity inside a Room
      match /players/{playerId} {
        allow get: if isValidId(roomId)
          && isValidId(playerId)
          && isVerifiedUser()
          && exists(/databases/$(database)/documents/online_rooms/$(roomId));

        allow list: if isValidId(roomId)
          && isVerifiedUser()
          && resource.data.roomId == roomId;

        allow create: if isValidId(roomId)
          && isValidId(playerId)
          && isVerifiedUser()
          && playerId == request.auth.uid
          && isValidOnlinePlayer(incoming(), roomId, playerId)
          && isRecentServerTime(incoming().createdAt)
          && isRecentServerTime(incoming().updatedAt)
          && get(/databases/$(database)/documents/online_rooms/$(roomId)).data.status != 'closed';

        allow update: if isValidId(roomId)
          && isValidId(playerId)
          && isVerifiedUser()
          && playerId == request.auth.uid
          && isValidOnlinePlayer(incoming(), roomId, playerId)
          && incoming().uid == existing().uid
          && incoming().roomId == existing().roomId
          && incoming().createdAt == existing().createdAt
          && isRecentServerTime(incoming().updatedAt)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'googleDisplayName',
            'googlePhotoURL',
            'driverName',
            'rank',
            'carId',
            'paintColor',
            'paintFinish',
            'spoiler',
            'bodyKit',
            'x',
            'y',
            'z',
            'heading',
            'vx',
            'vz',
            'speedKmh',
            'steerAngle',
            'braking',
            'nitroActive',
            'headlightsOn',
            's',
            'updatedAt'
          ]);

        allow delete: if isValidId(roomId)
          && isValidId(playerId)
          && isVerifiedUser()
          && (
            playerId == request.auth.uid
            || get(/databases/$(database)/documents/online_rooms/$(roomId)).data.hostUid == request.auth.uid
          );
      }
    }
  }
}
